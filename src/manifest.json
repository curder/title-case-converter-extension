{
  "manifest_version": 3,
  "name": "Title Case Converter",
  "description": "将输入框中的文本转换为标题格式",
  "author": "Curder",
  "homepage_url": "https://github.com/curder/chrome-camel-case-words-extension",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Convert to Title Case"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "将文本转换为标题格式"
    }
  }
}
