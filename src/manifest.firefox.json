{
  "browser_specific_settings": {
    "gecko": {
      "id": "q.curder@gmail.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
